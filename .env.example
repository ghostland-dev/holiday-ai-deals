# TravelAI Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# Application Configuration
VITE_APP_NAME=TravelAI
VITE_APP_VERSION=1.0.0
VITE_APP_DOMAIN=travelai.com
NODE_ENV=production

# API Configuration
VITE_API_BASE_URL=https://api.travelai.com

# AI Services
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Analytics & Monitoring
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Affiliate IDs (for commission tracking)
VITE_BOOKING_AFFILIATE_ID=travelai_booking_123
VITE_SKYSCANNER_AFFILIATE_ID=travelai_skyscanner_123
VITE_EXPEDIA_AFFILIATE_ID=travelai_expedia_123
VITE_AGODA_AFFILIATE_ID=travelai_agoda_123

# Authentication & Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Payment Processing
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key

# Push Notifications
VITE_PUSH_NOTIFICATION_KEY=your_vapid_public_key
VITE_VAPID_PRIVATE_KEY=your_vapid_private_key

# Security
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Email Services
VITE_SENDGRID_API_KEY=your_sendgrid_api_key
VITE_MAILCHIMP_API_KEY=your_mailchimp_api_key

# Social Login
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
VITE_FACEBOOK_APP_ID=your_facebook_app_id

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true

# Development Only
VITE_DEBUG_MODE=false
VITE_MOCK_API=false